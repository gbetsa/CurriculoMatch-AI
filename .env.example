# Provedor de LLM (groq, openai, ollama)
LLM_PROVIDER=groq

# Groq API Key (obrigatorio)
GROQ_API_KEY=your_groq_api_key_here

# Modelo LLM (opcional, default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# Temperatura do LLM (opcional, default: 0)
LLM_TEMPERATURE=0

# Banco de Dados - Checkpointer LangGraph (obrigatorio)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curriculomatch

# Log Level (opcional, default: INFO)
LOG_LEVEL=INFO

# URLs do n8n (usadas pelo Streamlit)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/analyze
N8N_BATCH_WEBHOOK_URL=http://localhost:5678/webhook/analyze-batch

# LangSmith tracing (opcional, para observabilidade avancada)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
